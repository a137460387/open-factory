{
  "name": "open-factory",
  "license": "MIT",
  "version": "4.79.0",
  "private": true,
  "packageManager": "bun@1.3.14",
  "description": "Local-first desktop video editor with AI-powered editing and plugin extensibility.",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/a137460387/open-factory.git"
  },
  "homepage": "https://github.com/a137460387/open-factory#readme",
  "bugs": {
    "url": "https://github.com/a137460387/open-factory/issues"
  },
  "type": "module",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "cd apps/desktop && bun run dev",
    "create-plugin": "bun tools/create-plugin/index.ts",
    "typecheck": "tsc -b",
    "test": "vitest run --coverage",
    "format": "prettier --write \"packages/editor-core/src/**/*.ts\" \"apps/desktop/src/**/*.{ts,tsx}\"",
    "format:check": "prettier --check \"packages/editor-core/src/**/*.ts\" \"apps/desktop/src/**/*.{ts,tsx}\"",
    "e2e": "cd apps/desktop && bun run e2e",
    "e2e:headed": "cd apps/desktop && bun run e2e:headed",
    "e2e:ui": "cd apps/desktop && bun run e2e:ui",
    "build": "tsc -p packages/editor-core/tsconfig.build.json && tsc -p packages/plugin-sdk/tsconfig.build.json && cd apps/desktop && bun run build",
    "tauri:dev": "cd apps/desktop && bun run tauri:dev",
    "tauri:build": "cd apps/desktop && bun run tauri:build",
    "smoke:tauri": "cd apps/desktop && bun run smoke:tauri",
    "smoke:preview": "cd apps/desktop && bun run smoke:preview",
    "smoke:dialog": "cd apps/desktop && bun run smoke:dialog",
    "smoke:cancel": "cd apps/desktop && bun run smoke:cancel",
    "smoke:golden": "cd apps/desktop && bun run smoke:golden",
    "media:compat": "node scripts/media-compat-test.mjs",
    "check:release": "node scripts/check-release.mjs",
    "depcruise": "depcruise packages/editor-core/src --config .dependency-cruiser.cjs",
    "depcruise:ci": "depcruise packages/editor-core/src --config .dependency-cruiser.cjs --output-type err-long",
    "lint": "eslint packages/ apps/desktop/src/",
    "lint:ci": "eslint packages/ apps/desktop/src/ --max-warnings 431",
    "docs:generate": "typedoc",
    "docs:serve": "typedoc --watch --serve",
    "check:bundle": "bun run scripts/check-bundle-size.ts",
    "changelog": "bun run scripts/generate-changelog.ts"
  },
  "devDependencies": {
    "@eslint/js": "^9.0.0",
    "@playwright/test": "^1.53.1",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.1",
    "@types/node": "^26.1.1",
    "@typescript-eslint/eslint-plugin": "^8.0.0",
    "@typescript-eslint/parser": "^8.0.0",
    "@vitest/coverage-v8": "^3.2.7",
    "dependency-cruiser": "^18.1.0",
    "eslint": "^9.0.0",
    "eslint-plugin-react-hooks": "^5.0.0",
    "jsdom": "^29.1.1",
    "prettier": "^3.9.5",
    "typedoc": "^0.28.20",
    "typedoc-plugin-markdown": "^4.12.0",
    "typescript": "^5.8.3",
    "typescript-eslint": "^8.0.0",
    "vitest": "^3.2.7"
  },
  "overrides": {
    "esbuild": ">=0.28.1",
    "@fastify/static": ">=10.1.2",
    "js-yaml": "^4.3.1",
    "linkify-it": "^5.0.2",
    "postcss": ">=8.5.26",
    "sharp": ">=0.35.0",
    "undici": "^7.29.0",
    "fast-uri": "4.1.2"
  },
  "dependencies": {}
}
