{
  "$schema": "https://unpkg.com/knip@5/schema.json",
  "workspaces": {
    "packages/editor-core": {
      "project": ["src/**/*.{ts,tsx}"]
    },
    "apps/desktop": {
      "project": ["src/**/*.{ts,tsx}"]
    }
  },
  "ignore": [
    "**/__tests__/**",
    "**/*.test.*",
    "**/*.spec.*",
    "**/e2e/**"
  ],
  "ignoreIssues": {
    "apps/desktop/src/lib/tauri-bridge/**": ["exports", "types"],
    "apps/desktop/src/observability/**": ["exports", "types"],
    "apps/desktop/src/video-gen/**": ["exports", "types"],
    "packages/editor-core/src/**": ["exports", "types"],
    "packages/cli/src/**": ["exports", "types"],
    "packages/creator-dashboard/src/**": ["exports", "types"],
    "examples/plugins/**": ["exports", "types"]
  },
  "include": ["exports", "types"]
}
