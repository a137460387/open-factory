{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "strict": true,
    "declaration": true,
    "declarationMap": true,
    "sourceMap": true,
    "composite": true,
    "rootDir": "src",
    "outDir": "dist",
    "skipLibCheck": true,
    "paths": {
      "@open-factory/editor-core": [
        "../editor-core/src/index.ts"
      ],
      "@open-factory/editor-core/*": [
        "../editor-core/src/*"
      ]
    },
    "noImplicitOverride": true,
    "noFallthroughCasesInSwitch": true,
    "useUnknownInCatchVariables": true
  },
  "include": [
    "src/**/*.ts"
  ],
  "references": [
    {
      "path": "../editor-core"
    }
  ]
}
